{
  "name": "frontend",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:coverage": "vitest run --coverage",
    "test:ci": "NODE_OPTIONS='--trace-deprecation' vitest run --coverage",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prettier:fix": "prettier '**/*.*' --write",
    "prettier:check": "prettier . --check",
    "ci": "run-s lint prettier:check type-check test:ci"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.5",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/vue-query": "^5.105.2",
    "axios": "^1.21.0",
    "mitt": "^3.0.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.2",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.44",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query-devtools": "^6.3.8",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.5.2",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.1",
    "eslint-plugin-oxlint": "~1.31.0",
    "eslint-plugin-vue": "~10.6.2",
    "jiti": "^2.7.0",
    "jsdom": "^28.1.0",
    "lodash": "^4.18.1",
    "msw": "^2.12.4",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.31.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "type-fest": "^5.10.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-router-mock": "^2.0.2",
    "vue-tsc": "^3.3.14"
  }
}
